{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentOutputV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "pet_action",
    "strategy",
    "suggested_task",
    "sources"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1
    },
    "pet_action": {
      "enum": [
        "idle",
        "happy",
        "think",
        "sleep",
        "eat",
        "roll",
        "sad"
      ]
    },
    "strategy": {
      "enum": [
        "listen",
        "focus",
        "relax",
        "clarify",
        "feedback",
        "support"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "verified_on"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "verified_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "suggested_task": {
      "enum": [
        "focus_25",
        "relax_2",
        null
      ]
    }
  }
}
