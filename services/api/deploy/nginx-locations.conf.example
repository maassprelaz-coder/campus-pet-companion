# Include inside nkupet.fun's EXISTING HTTPS server block, after checking route conflicts.
# Preserve its existing root, certificate and page routes. Never serve the repository root.
# Backend runs on 127.0.0.1:8788 with PUBLIC_ORIGIN=https://nkupet.fun.

location = /health {
    proxy_pass http://127.0.0.1:8788;
    proxy_set_header Host 127.0.0.1:8788;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_cache off;
}

location ^~ /api/v1/ {
    client_max_body_size 16k;
    proxy_pass http://127.0.0.1:8788;
    proxy_set_header Host 127.0.0.1:8788;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_cache off;
}
